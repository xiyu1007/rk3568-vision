{
  "capture": {
    "device": "/dev/video0",
    "width": 1280,
    "height": 720,
    "fps": 25,
    "pixel_format": "NV12",
    "buffer_count": 6,
    "use_mplane": true
  },
  "inference": {
    "enabled": true,
    "backend": "auto",
    "model_path": "model/yolov5s.rknn",
    "labels_path": "model/coco_80_labels_list.txt",
    "conf_threshold": 0.25,
    "nms_threshold": 0.45,
    "model_width": 640,
    "model_height": 640,
    "npu_core": 0
  },
  "pacer": {
    "enabled": true,
    "target_fps": 25,
    "allow_duplicate": true,
    "queue_depth": 8
  },
  "encode": {
    "enabled": true,
    "hardware": true,
    "codec": "h264",
    "bitrate": 4000000,
    "gop_size": 50,
    "preset": "fast",
    "profile": "high"
  },
  "stream": {
    "enabled": true,
    "url": "rtmp://127.0.0.1/live/stream",
    "reconnect": true,
    "reconnect_delay_ms": 2000,
    "max_reconnect": -1
  },
  "record": {
    "enabled": false,
    "path": "output/record.mp4",
    "segment_seconds": 0
  },
  "monitor": {
    "enabled": true,
    "log_interval_ms": 5000
  },
  "logging": {
    "level": "info",
    "file": "log/rk3568_vision.log",
    "console": true,
    "async": true,
    "max_size": 10485760,
    "backup_count": 3
  }
}
